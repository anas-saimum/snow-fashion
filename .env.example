# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider (not connected in the MVP).
# Set to "stripe" and fill the keys once lib/payments/stripe.provider.ts exists.
NEXT_PUBLIC_PAYMENT_PROVIDER=none
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Newsletter / contact delivery (not connected in the MVP).
# NEWSLETTER_API_KEY=
# CONTACT_FORWARD_EMAIL=
