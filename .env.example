# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
# Leave it out entirely on Vercel and the deployment URL is detected instead;
# an EMPTY value is treated as missing (see config/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — powers the admin dashboard at /admin (database, auth, storage).
#
# Without these the storefront runs on the built-in demo catalogue, and the
# dashboard runs in an in-memory demo mode under `next dev` (or refuses to
# load in production). See README → Admin dashboard for the 10-minute setup.
#
# The anon key is PUBLIC by design — row-level security is what protects the
# data. Never put the service_role key in this project; nothing here needs it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Admin sign-in without Supabase — a single login ID and password.
#
# When both are set (and Supabase is not), /admin requires signing in at
# /admin/login with these. Server-only: they are never sent to the browser.
# Pick a long random password; there is no lockout or rate limit yet.
#
# ADMIN_SESSION_SECRET signs the session cookie. Optional — without it the
# cookie is keyed from the credentials, so changing the password signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# With Supabase configured these are ignored: its accounts are used instead.
# ---------------------------------------------------------------------------
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Payment provider (not connected).
# Set to "stripe" and fill the keys once lib/payments/stripe.provider.ts exists.
NEXT_PUBLIC_PAYMENT_PROVIDER=none
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Newsletter / contact delivery (not connected).
# NEWSLETTER_API_KEY=
# CONTACT_FORWARD_EMAIL=
