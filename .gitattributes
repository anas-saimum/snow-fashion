# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Binary assets — never touch these.
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff  binary
*.woff2 binary

# Generated: keep diffs out of review.
package-lock.json linguist-generated=true -diff
